{
  "$description": "Дизайн-токены бренда VK Cloud (учебный пример Verstka, бренд условный)",
  "$extensions": {
    "ru.verstka": {
      "name": "VK Cloud",
      "rules": [
        "Логотип — в правом нижнем углу",
        "Поля — 48 px",
        "Акцент — только для главного числа"
      ]
    }
  },
  "color": {
    "$type": "color",
    "palette": {
      "vk-blue": {
        "$value": "#0077FF",
        "$description": "VK Blue"
      },
      "cloud-blue": {
        "$value": "#2787F5",
        "$description": "Cloud Blue"
      },
      "night": {
        "$value": "#0B1220",
        "$description": "Night"
      },
      "white": {
        "$value": "#FFFFFF",
        "$description": "White"
      },
      "pink": {
        "$value": "#FF3985",
        "$description": "Pink"
      },
      "sky": {
        "$value": "#00C2FF",
        "$description": "Sky"
      }
    },
    "role": {
      "primary": {
        "$value": "{color.palette.vk-blue}",
        "$description": "Основной цвет: фирменные плашки, первая серия диаграмм"
      },
      "secondary": {
        "$value": "{color.palette.cloud-blue}",
        "$description": "Дополнительный цвет: вторая серия диаграмм"
      },
      "text": {
        "$value": "{color.palette.night}",
        "$description": "Заголовки и основной текст"
      },
      "background": {
        "$value": "{color.palette.white}",
        "$description": "Фон слайдов"
      },
      "accent": {
        "$value": "{color.palette.pink}",
        "$description": "Только для главного числа на слайде"
      }
    },
    "chart": {
      "1": {
        "$value": "{color.palette.vk-blue}"
      },
      "2": {
        "$value": "{color.palette.cloud-blue}"
      },
      "3": {
        "$value": "{color.palette.sky}"
      },
      "4": {
        "$value": "{color.palette.night}"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": {
        "$value": [
          "VK Sans Display",
          "Play",
          "sans-serif"
        ]
      },
      "body": {
        "$value": [
          "VK Sans Text",
          "Play",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "heading": {
        "$value": 700
      },
      "body": {
        "$value": 400
      }
    }
  },
  "typography": {
    "$type": "typography",
    "heading": {
      "$value": {
        "fontFamily": "{font.family.heading}",
        "fontWeight": "{font.weight.heading}",
        "fontSize": {
          "value": 40,
          "unit": "px"
        },
        "lineHeight": 1.1
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": "{font.weight.body}",
        "fontSize": {
          "value": 18,
          "unit": "px"
        },
        "lineHeight": 1.3
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "slide": {
      "width": {
        "$value": {
          "value": 1920,
          "unit": "px"
        }
      },
      "height": {
        "$value": {
          "value": 1080,
          "unit": "px"
        }
      }
    },
    "margin": {
      "$value": {
        "value": 48,
        "unit": "px"
      },
      "$description": "Поля слайда со всех сторон"
    },
    "grid": {
      "columns": {
        "$type": "number",
        "$value": 12
      },
      "gutter": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      }
    }
  },
  "logo": {
    "position": {
      "$value": "bottom-right",
      "$description": "Логотип — в правом нижнем углу слайда"
    }
  }
}
