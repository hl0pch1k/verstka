# Polza.ai (https://polza.ai): один ключ на все три модели — основную Qwen3.8-27B, запасную Qwen3.6-27B и Z-Image для
# изображений внутри слайдов (открытые веса, Apache 2.0). Баланс в рублях; ключ — в консоли Polza: Dashboard → API-ключи.
POLZA_API_KEY=
# Workspace root for template analysis cache and generations (default ./workspace)
VERSTKA_WORKSPACE=./workspace
# Финал (топ-10): по ТЗ обязателен инференс VK (Qwen3.8-27B) — configs/models.vk.yaml. Когда заданы оба ключа ниже,
# профиль VK выбирается сам; картинки в нём рисует Z-Image через POLZA_API_KEY (выше).
# VK_INFERENCE_API_KEY=
# VK_PROJECT_ID=
# Принудительно выбрать профиль (важнее ключей VK): configs/models.vk.yaml или configs/models.yaml
# VERSTKA_MODELS=
# Собственная модель изображений VK (открытые веса ≤ 20B, Apache 2.0 / MIT), если он её предоставит; Z-Image отвечает после неё
# VK_T2I_MODEL=
