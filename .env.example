# Модели: профиль выбирается по ключам. С обоими ключами VK (ниже) работает профиль VK — configs/models.vk.yaml; без них —
# профиль Polza, configs/models.yaml. Без ключей вообще сервис работает без моделей (офлайн). Подробнее: MODELS.md.

# Polza.ai (https://polza.ai): один ключ на все три модели — основную Qwen3.8-27B, запасную Qwen3.6-27B и Z-Image для
# изображений внутри слайдов (открытые веса, Apache 2.0). Баланс в рублях; ключ — в консоли Polza: Dashboard → API-ключи.
# С ключами VK этот ключ тоже нужен: если инференс VK не отвечает, тот же запрос уходит той же Qwen3.8-27B на Polza,
# затем Qwen3.6-27B; изображения рисует Z-Image на Polza. Без него — только VK, а места под изображения остаются свободными.
POLZA_API_KEY=
# Папка для кэша разбора шаблонов, файлов с данными, брендбуков и генераций (по умолчанию ./workspace)
VERSTKA_WORKSPACE=./workspace
# Финал (топ-10): по ТЗ обязателен инференс VK (Qwen3.8-27B, qwen38-27b-fp8) — configs/models.vk.yaml. Когда заданы оба ключа ниже,
# профиль VK выбирается сам: VK спрашивается первым, при недоступности отвечает Polza (POLZA_API_KEY выше).
# VK_INFERENCE_API_KEY=
# VK_PROJECT_ID=
# Принудительно выбрать профиль (важнее ключей VK): configs/models.vk.yaml или configs/models.yaml. Если здесь задан не VK,
# а ключи VK тоже есть, сервер пишет в журнал предупреждение — тогда уберите эту строку.
# VERSTKA_MODELS=
# Собственная модель изображений VK (открытые веса ≤ 20B, Apache 2.0 / MIT), если он её предоставит; Z-Image отвечает после неё
# VK_T2I_MODEL=

# Брендбук по ссылке на файл Figma: личный токен (Figma → Settings → Security → Personal access tokens). Без него ссылка Figma
# не читается; PDF, токены JSON, папки и архивы читаются без токена.
# FIGMA_TOKEN=

# Пределы размера загрузки, МБ (в скобках — значения по умолчанию; интерфейс заранее проверяет значения по умолчанию)
# VERSTKA_MAX_UPLOAD_MB=200   # шаблон
# VERSTKA_MAX_DATA_MB=25      # файл с данными: CSV, TSV, JSON
# VERSTKA_MAX_XLSX_MB=4       # книга Excel
# VERSTKA_MAX_TEXT_MB=15      # текст с таблицей
# VERSTKA_MAX_BRAND_MB=50     # брендбук: файл, папка или архив
# VERSTKA_MAX_DOC_MB=25       # документ DOCX / PDF как текст презентации
# VERSTKA_MAX_KB_UPLOAD_MB=100  # документы базы знаний за одну загрузку

# Текст по короткой теме («Сделай презентацию про интегралы»): писатель берёт факты из статьи Википедии (один запрос к
# MediaWiki на тему) или из базы знаний. VERSTKA_WIKI=0 — без Википедии, VERSTKA_WRITER=0 — писатель выключен (configs/writer.yaml).
# VERSTKA_WIKI=0
# VERSTKA_WRITER=0

# LibreOffice (картинки слайдов, PDF): путь к soffice или команда, если он стоит в нестандартном месте. Без этой строки сервис
# ищет в PATH, в приложении macOS, в пакете дистрибутива и в /opt/libreofficeX.Y/program (официальные сборки .deb).
# VERSTKA_SOFFICE=
