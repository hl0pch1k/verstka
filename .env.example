# OpenAI-compatible provider with open-weight models (OpenRouter by default, see configs/models.yaml).
# Тот же ключ включает изображения внутри слайдов (роль t2i: FLUX.2 [klein] 4B, Ming-Image-0.1-Design — открытые веса).
OPENROUTER_API_KEY=
# Необязательно: ключ Groq — та же модель Qwen3.8-27B на другом хосте, бесплатно и без карты (console.groq.com → API Keys)
# GROQ_API_KEY=
# Необязательно: ключ Cloud.ru Foundation Models — Qwen3-VL-30B-A3B и запасная Qwen3-32B, оплата российской картой, около 3 ₽ за презентацию (cloud.ru)
# CLOUDRU_API_KEY=
# Workspace root for template analysis cache and generations (default ./workspace)
VERSTKA_WORKSPACE=./workspace
# Optional: alternative models.yaml (e.g. VK inference at the final)
# VERSTKA_MODELS=configs/models.vk.yaml
# Инференс VK для configs/models.vk.yaml: адрес OpenAI-совместимого API и ключ
# VK_INFERENCE_BASE_URL=
# VK_INFERENCE_API_KEY=
# Модель изображений на инференсе VK (открытые веса ≤ 20B, Apache 2.0 / MIT), если он её предоставит
# VK_T2I_MODEL=
